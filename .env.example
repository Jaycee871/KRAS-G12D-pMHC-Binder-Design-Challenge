# Copy to .env and fill in locally:  cp .env.example .env
#
# ---------------------------------------------------------------------------
# REAL KEYS ARE NEVER COMMITTED.
# .env is git-ignored. In CI, store these as GitHub Actions secrets
# (Settings -> Secrets and variables -> Actions) and read them from the
# environment. Do not paste a key into code, a notebook, a commit message,
# an issue, or a log line.
# ---------------------------------------------------------------------------

# NVIDIA NGC / build.nvidia.com API key - hosted inference for structure and
# design models (e.g. RFdiffusion, ProteinMPNN, AlphaFold2 NIM endpoints).
NVIDIA_API_KEY=

# Hugging Face token - pulling model weights / datasets that require auth.
HF_TOKEN=

# Literature API key (Nature / Springer Nature API, or equivalent) - used for
# background reading on KRAS G12D pMHC targeting; not required to run the code.
NATURE_API_KEY=
